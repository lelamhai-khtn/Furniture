<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Typography -->
    <style name="Typography" />

    <!-- H1 -->
    <style name="Typography.H1">
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">64sp</item>
    </style>

    <!-- H2 -->
    <style name="Typography.H2">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">56sp</item>
    </style>

    <!-- H3 -->
    <style name="Typography.H3">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="lineHeight">44sp</item>
    </style>

    <!-- H4 -->
    <style name="Typography.H4">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="lineHeight">36sp</item>
    </style>

    <!-- H5 -->
    <style name="Typography.H5">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="lineHeight">32sp</item>
    </style>

    <!-- Body -->
    <style name="Typography.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="lineHeight">24sp</item>
    </style>

    <!-- Body-em -->
    <style name="Typography.BodyEm">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="lineHeight">24sp</item>
    </style>

    <!-- Body-sm -->
    <style name="Typography.BodySm">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="lineHeight">20sp</item>
    </style>
</resources>