<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Systems"/>
    <!-- H1 -->
    <style name="Systems.H1">
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">64sp</item>
    </style>

    <!-- H2 -->
    <style name="Systems.H2">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">56sp</item>
    </style>

    <!-- H3 -->
    <style name="Systems.H3">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="lineHeight">44sp</item>
    </style>

    <!-- H4 -->
    <style name="Systems.H4">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="lineHeight">36sp</item>
    </style>

    <!-- H5 -->
    <style name="Systems.H5">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="lineHeight">32sp</item>
    </style>

    <!-- Home -->
    <style name="Systems.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/BlackText</item>
        <item name="fontFamily">@font/poppins_semi_bold</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="Systems.NameProduct">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/BlackText</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="Systems.PriceProduct">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/Primary3</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="Systems.DescriptionOldProduct">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/GrayBorder</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="lineHeight">16sp</item>
    </style>
</resources>