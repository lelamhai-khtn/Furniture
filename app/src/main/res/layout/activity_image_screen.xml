<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".activity.ImageScreen">

    <!-- App Bar -->
    <include
        android:id="@+id/app_bar_image"
        layout="@layout/app_bar_image" />

    <!-- CropImageView lấp đầy phần còn lại -->
    <com.canhub.cropper.CropImageView
        android:id="@+id/cropImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/app_bar_image"
        android:background="@color/white"
        app:cropShape="oval"
        app:cropFixAspectRatio="true"
        app:cropAspectRatioX="1"
        app:cropAspectRatioY="1"
        app:cropGuidelines="on"
        app:cropBorderCornerThickness="0dp"
        app:cropBorderCornerLength="0dp"
        app:cropTouchRadius="1dp"
        />
    <!-- Đã xóa dòng: android:layout_above="@+id/layout_bottom" -->

    <!-- Nút Save sẽ nổi (float) lên trên phần dưới cùng của CropImageView -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_crop_and_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:backgroundTint="@color/Primary100"
            android:text="Save"
            />
    </LinearLayout>
</RelativeLayout>