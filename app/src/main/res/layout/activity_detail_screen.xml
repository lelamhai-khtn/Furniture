<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:padding="32dp"
                        app:srcCompat="@drawable/chair" />

                    <ImageButton
                        android:id="@+id/ib_favorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:layout_margin="16dp"
                        android:background="@null"
                        app:srcCompat="@drawable/favorite_24"
                        android:contentDescription="Nút yêu thích" /> <!-- Thêm mô tả hoặc dùng tools:ignore="ContentDescription" -->

                    <ImageButton
                        android:id="@+id/ib_ar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="16dp"
                        android:background="@null"
                        app:srcCompat="@drawable/outline_view_in_ar_24"
                        android:contentDescription="Xem chế độ AR" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_name_product"
                    style="@style/Systems.Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chair beautiful" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_price_product"
                        style="@style/Systems.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100$" />

                    <TextView
                        style="@style/Systems.Description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120$" />
                </LinearLayout>

                <TextView
                    style="@style/Systems.Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decription Decription Decription Decription Decription Decription" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Systems.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Similar Products" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_best_product"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="2dp"
            android:background="@drawable/bg_shadow_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_rounded_top"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GIAO DIỆN A"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>


